generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}
model User {
  id    String   @id @default(cuid())
  name       String
  email      String   @unique
  hashed_password String
  role       Role     @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}