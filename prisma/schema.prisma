generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}
model User {
  id    String   @id @default(cuid())
  name       String
  email      String   @unique
  hashedPassword String
  role       Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id String @id @default(cuid())
  tokenHashed String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id String @id @default(cuid())
  name String
  description String?
  price Decimal @db.Decimal(10, 2)
  stock Int
  imageUrl String
  category String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}